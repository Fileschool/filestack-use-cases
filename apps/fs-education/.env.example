# ---------------------------------------------------------------------------
# Filestack
# ---------------------------------------------------------------------------
# Required. Found at https://dev.filestack.com/ -> API Keys.
# Exposed to the browser: the File Picker and blob uploads run client side.
NEXT_PUBLIC_FILESTACK_API_KEY=

# Optional. Only needed if "Security" (signed policies) is enabled on your
# Filestack app. Keep this server-side only - never prefix it with NEXT_PUBLIC.
# FILESTACK_APP_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development needs nothing: the app falls back to a file-backed libSQL
# database (a local SQLite cache) at .data/fs-education.db.
# Override the location if you want to:
# LOCAL_DATABASE_URL=file:.data/fs-education.db

# When hosted, point these at Turso and the same code path is used.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=

# Public URL, for canonical links, the sitemap and structured data. Defaults
# to https://www.filestack.com/use-cases/demos/education.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_PATH=

# Where Next serves from. Leave empty locally. Behind the filestack.com
# rewrite, set it to the same sub-path, /use-cases/demos/education
NEXT_PUBLIC_BASE_PATH=
