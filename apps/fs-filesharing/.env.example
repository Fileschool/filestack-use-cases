NEXT_PUBLIC_FILESTACK_API_KEY=your_filestack_api_key
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Public URL, for canonical links, the sitemap and structured data. Defaults
# to https://www.filestack.com/use-cases/demos/file-sharing.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_PATH=

# Where Next serves from. Leave empty locally. Behind the filestack.com
# rewrite, set it to the same sub-path, /use-cases/demos/file-sharing
NEXT_PUBLIC_BASE_PATH=
