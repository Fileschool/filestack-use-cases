# ---------------------------------------------------------------------------
# Filestack
# ---------------------------------------------------------------------------
# Required. https://dev.filestack.com/ -> API Keys
# Public by necessity: uploads go from the browser straight to Filestack.
NEXT_PUBLIC_FILESTACK_API_KEY=

# Required for the Intelligence tasks used here (ocr, envelope_ocr,
# doc_detection). Those tasks reject unsigned requests, so the app signs a
# short-lived policy server side. NEVER prefix this with NEXT_PUBLIC_.
FILESTACK_APP_SECRET=

# Optional. Only needed by the apps that use virus detection, which is a
# Workflows-only task. Create the workflow in the Filestack dashboard and
# paste its id here.
FILESTACK_WORKFLOW_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development needs nothing: the app falls back to a file-backed libSQL
# database at .data/ardmore.db, created and seeded on first run.
# LOCAL_DATABASE_URL=file:.data/ardmore.db

# When hosted, point these at Turso and the same code path is used.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=
